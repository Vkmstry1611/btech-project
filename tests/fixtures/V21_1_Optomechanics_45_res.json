      ]
    },
    {
      "block_label": "text",
      "block_content": "The PSY403 external post adapter allows the Faraday Cage to be used with our ScienceDesk post-mounted accessories. The adapter bolts to the upper rails of a ScienceDesk frame and provides a single post-mounting through hole. Common applications of this adapter are for mounting a monitor (PSY120 or PSY121 Support Bracket), attaching a keyboard holder (PSY132), or mounting a single shelf (PSY191).",
      "block_bbox": [
        519,
        220,
        1067,
        461
