    {
      "block_label": "text",
      "block_content": "Customized mounting solutions within a Faraday cage enclosure are made possible with the PSY404 adapter kit. By attaching one of the adapter plates included in the PSY404 kit to each end of a user-supplied XE25series rail (see page 218 for details), the rail can be mounted perpendicular to a segment of the Faraday cage's XE25-compatible frame as shown in the photo to the left. A common application of this adapter is to construct a mounting structure within the Faraday cage that does not disturb the vibration-isolated experiment.",
      "block_bbox": [
        385,
        1163,
        917,
        1463
      ]
    },
    {
      "block_label": "image",
      "block_content": "\n\n",
